# BUDDY — Smart AI College Reception Robot Configuration
# Copy this file to .env and adjust values for your environment.

# ==========================================
# 1. Local AI Model (Ollama)
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=60.0

# When Ollama is offline or model is not downloaded, enable simulated reception AI
MOCK_AI_FALLBACK=true

# ==========================================
# 2. Cloud AI & Web Research (Groq LPU) [Optional]
# ==========================================
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ==========================================
# 3. SQLite Database
# ==========================================
DATABASE_PATH=./data/buddy.db

# ==========================================
# 4. Web Search (SearXNG / DuckDuckGo fallback)
# ==========================================
WEB_SEARCH_ENABLED=true
SEARXNG_BASE_URL=http://localhost:8080
WEB_SEARCH_TIMEOUT_SECONDS=10.0

# ==========================================
# 4. Speech Recognition (faster-whisper)
# ==========================================
STT_MODEL=base
STT_DEVICE=cuda
STT_LANGUAGE=en

# ==========================================
# 5. Text-To-Speech (Fish Audio S2 Pro)
# ==========================================
TTS_ENABLED=true
FISH_TTS_SERVER_URL=http://127.0.0.1:3030

# ==========================================
# 6. Server & Security Settings
# ==========================================
FRONTEND_ORIGIN=http://localhost:5173
SERVER_HOST=127.0.0.1
SERVER_PORT=8000

# Administrator Credentials (DEMO ONLY - change before production deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=buddyadmin2026
ADMIN_TOKEN_SECRET=buddy-secret-token-key-2026

# Agent Limits
MAX_TOOL_ITERATIONS=5
SESSION_MAX_HISTORY=15

# ==========================================
# 7. ESP32-S3 Hardware WS2812 RGB LED (GPIO 48)
# ==========================================
ESP32_LED_ENABLED=true
ESP32_LED_URL=http://192.168.1.100
ESP32_LED_TIMEOUT_SECONDS=1.0
ESP32_LED_TOKEN=

